      { w: "स्वाभिमान", a: "आफ्नो इज्जत वा आत्मसम्मान" },
      { w: "हार्दिकता", a: "हृदयदेखिको माया वा आत्मीयता" },
      { w: "अग्निपरीक्षा", a: "कठिन जाँच वा कसौटी" },
