      { w: "उन्मुख", a: "तर्फ फर्केको वा अघि बढेको" },
      { w: "उत्कृष्टता", a: "श्रेष्ठता वा अत्यन्त राम्रोपन" },
      { w: "एकता", a: "मेलमिलाप वा एकजुटता" },
      { w: "करुणा", a: "दया वा सहानुभूति" },
      { w: "कारोबार", a: "लेनदेन वा व्यापार" },
      { w: "कृतज्ञता", a: "उपकार मान्ने भाव" },
      { w: "गौरव", a: "मान, इज्जत वा घमण्ड" },
      { w: "गतिशीलता", a: "निरन्तर अघि बढ्ने गुण" },
      { w: "चेत", a: "होस वा चेतना" },
      { w: "जागरुकता", a: "सचेत हुने अवस्था" },
      { w: "तार्किकता", a: "युक्ति वा तर्कपूर्ण हुनाको भाव" },
      { w: "दृष्टिकोण", a: "हेर्ने वा सोच्ने विचार" },
      { w: "निष्ठा", a: "इमानदारी वा श्रद्धा" },
      { w: "परम्परा", a: "पहिल्यैदेखि चलिआएको चलन" },
      { w: "परिणाम", a: "नतिजा वा फल" },
      { w: "पुनर्जागरण", a: "पुनः ब्युँझिने वा नयाँ युगको सुरुवात" },
      { w: "प्रतिक्रिया", a: "घटनापछिको उत्तर वा असर" },
      { w: "प्रतिष्ठा", a: "इज्जत, मान वा प्रसिद्धि" },
      { w: "प्रभावी", a: "असर पार्ने वा शक्तिशाली" },
      { w: "मालिक", a: "धनी वा स्वामी" },
      { w: "मूल्यमान्यता", a: "सामाजिक संस्कार र सिद्धान्त" },
      { w: "युगान्तकारी", a: "नयाँ युग ल्याउने वा ठूलो परिवर्तन गर्ने" },
      { w: "सक्रियता", a: "जाँगर वा निरन्तर लागिपर्ने गुण" },
      { w: "सदाचार", a: "असल चालचलन वा व्यवहार" },
      { w: "स्वावलम्बन", a: "आफ्नो गोडामा आफैँ उभिने कार्य" }
    ];

    // State Variables
    let currentQ = 0;
    let currentTurn = 0; // 0: A, 1: B, 2: C, 3: D
    let passCount = 0; // 0: Main (30s), 1: Pass 1 (15s), 2+: Pass 2+ (10s)
    let rotationDir = 'cw'; // 'cw' = Clockwise, 'ccw' = Anti-clockwise
    let scores = [0, 0, 0, 0];

    let totalDuration = 30;
    let timeLeft = 30;
    let timerInterval = null;
    let isTimerRunning = false;

    const groupNames = ["समूह 'क'", "समूह 'ख'", "समूह 'ग'", "समूह 'घ'"];
    const nepaliNumbers = ['०','१','२','३','४','५','६','७','८','९'];

    function toNepaliNum(num) {
      return num.toString().split('').map(d => nepaliNumbers[d] || d).join('');
    }

    // Load Question into UI
    function loadQuestion(index) {
      currentQ = index;
      passCount = 0;
      const q = quizData[index];
      
      document.getElementById('q-counter').innerText = `प्रश्न ${toNepaliNum(index + 1)} / १००`;
      document.getElementById('question-word').innerText = q.w;
      document.getElementById('answer-text').innerText = q.a;
      
      const answerBox = document.getElementById('answer-box');
      answerBox.classList.remove('revealed');

      setupTimerForCurrentState();
      updateGridHighlights();
    }

    // Timer Logic with Dynamic Rules (30s -> 15s -> 10s)
    function setupTimerForCurrentState() {
      clearInterval(timerInterval);
      isTimerRunning = false;
      document.getElementById('play-icon').className = "fa-solid fa-play";

      if (passCount === 0) {
        totalDuration = 30;
        document.getElementById('pass-tag').innerText = "मुख्य पालो (३० से.)";
      } else if (passCount === 1) {
        totalDuration = 15;
        document.getElementById('pass-tag').innerText = "पहिलो पास (१५ से.)";
      } else {
        totalDuration = 10;
        document.getElementById('pass-tag').innerText = `पास ${toNepaliNum(passCount)} (१० से.)`;
      }

      timeLeft = totalDuration;
      updateTimerDisplay();
      startTimer(); // Auto start timer on question load or pass
    }

    function toggleTimer() {
      if (isTimerRunning) {
        pauseTimer();
      } else {
        startTimer();
      }
    }

    function startTimer() {
      if (isTimerRunning) return;
      isTimerRunning = true;
      document.getElementById('play-icon').className = "fa-solid fa-pause";

      timerInterval = setInterval(() => {
        if (timeLeft > 0) {
          timeLeft--;
          updateTimerDisplay();
        } else {
          pauseTimer();
          // Auto Pass or Alert on Time Out
          document.getElementById('timer-card').classList.add('warning');
        }
      }, 1000);
    }

    function pauseTimer() {
      clearInterval(timerInterval);
      isTimerRunning = false;
      document.getElementById('play-icon').className = "fa-solid fa-play";
    }

    function updateTimerDisplay() {
      const sec = timeLeft < 10 ? `०${toNepaliNum(timeLeft)}` : toNepaliNum(timeLeft);
      document.getElementById('timer-display').innerText = `००:${sec}`;

      // Progress bar percentage
      const pct = (timeLeft / totalDuration) * 100;
      document.getElementById('timer-progress').style.width = `${pct}%`;

      // Warning glow below 5 sec
      const card = document.getElementById('timer-card');
      if (timeLeft <= 5 && timeLeft > 0) {
        card.classList.add('warning');
      } else if (timeLeft > 5) {
        card.classList.remove('warning');
      }
    }

    // Direction Switcher
    function setDirection(dir) {
      rotationDir = dir;
      document.getElementById('dir-cw').classList.toggle('active', dir === 'cw');
      document.getElementById('dir-ccw').classList.toggle('active', dir === 'ccw');
    }

    // Calculate Next Turn based on Clockwise / Anti-clockwise
    function getNextTeamIndex(curr) {
      if (rotationDir === 'cw') {
        return (curr + 1) % 4; // A -> B -> C -> D
      } else {
        return (curr + 3) % 4; // A -> D -> C -> B
      }
    }

    // Turn Switch Logic
    function setActiveTurn(newTurnIndex) {
      document.getElementById(`card-group-${currentTurn}`).classList.remove('active-turn');
      currentTurn = newTurnIndex;
      document.getElementById(`card-group-${currentTurn}`).classList.add('active-turn');
      document.getElementById('turn-label').innerHTML = `<i class="fa-solid fa-users"></i> पालो: ${groupNames[currentTurn]}`;
    }

    function manualTurnSwitch() {
      const nextIdx = getNextTeamIndex(currentTurn);
      setActiveTurn(nextIdx);
      passCount = 0;
      setupTimerForCurrentState();
    }

    // Pass Question Action
    function handlePass() {
      passCount++;
      const nextIdx = getNextTeamIndex(currentTurn);
      setActiveTurn(nextIdx);
      setupTimerForCurrentState();
    }

    // Scoring & Answers
    function updateScore(groupIndex, points) {
      scores[groupIndex] += points;
      document.getElementById(`score-${groupIndex}`).innerText = toNepaliNum(scores[groupIndex]);
    }

    function resetScores() {
      scores = [0, 0, 0, 0];
      for(let i=0; i<4; i++) {
        document.getElementById(`score-${i}`).innerText = '०';
      }
    }

    function revealAnswer() {
      document.getElementById('answer-box').classList.add('revealed');
    }

    function markCorrect() {
      revealAnswer();
      pauseTimer();
      updateScore(currentTurn, 10);
      confetti({ particleCount: 90, spread: 70, origin: { y: 0.7 } });
      setTimeout(() => {
        const nextIdx = getNextTeamIndex(currentTurn);
        setActiveTurn(nextIdx);
        nextQuestion();
      }, 1600);
    }

    function markWrong() {
      revealAnswer();
      pauseTimer();
      setTimeout(() => {
        const nextIdx = getNextTeamIndex(currentTurn);
        setActiveTurn(nextIdx);
        nextQuestion();
      }, 1600);
    }

    function nextQuestion() {
      if (currentQ < quizData.length - 1) {
        loadQuestion(currentQ + 1);
      }
    }

    function prevQuestion() {
      if (currentQ > 0) {
        loadQuestion(currentQ - 1);
      }
    }

    // Modal Builder
    function toggleModal() {
      const modal = document.getElementById('grid-modal');
      modal.style.display = modal.style.display === 'flex' ? 'none' : 'flex';
    }

    function buildGrid() {
      const container = document.getElementById('grid-container');
      container.innerHTML = '';
      quizData.forEach((item, idx) => {
        const btn = document.createElement('div');
        btn.className = `grid-item ${idx === currentQ ? 'active' : ''}`;
        btn.innerText = toNepaliNum(idx + 1);
        btn.onclick = () => {
          loadQuestion(idx);
          toggleModal();
        };
        container.appendChild(btn);
      });
    }

    function updateGridHighlights() {
      const items = document.querySelectorAll('.grid-item');
      items.forEach((item, idx) => {
        if (idx === currentQ) {
          item.classList.add('active');
        } else {
          item.classList.remove('active');
        }
      });
    }

    // Start App
    buildGrid();
    loadQuestion(0);
  </script>
</body>
</html>
```eof

### थप गरिएका विशेषताहरू (Features Added):
1. **अटो टाइमर तथा पास (Pass) नियम**:
   - **सुरुवाती पालो:** ३० सेकेन्डको घडी स्वतः सुरु हुन्छ।
   - **पहिलो पास (1st Pass):** `पास (Pass)` बटन थिच्दा अङ्क नघटी अर्को समूहको पालो आउँछ र घडी **१५ सेकेन्ड**मा रिसेट भएर चल्छ।
   - **दोस्रो र बाँकी पास (2nd Pass+):** पुनः पास गर्दा घडी **१० सेकेन्ड**मा रिसेट हुन्छ।

2. **घडीको दिशा / उल्टो दिशा (Clockwise & Anti-clockwise Rotation)**:
   - माथि हेडरमा रहेको स्विचरबाट `घडी (A ➔ B ➔ C ➔ D)` वा `उल्टो (A ➔ D ➔ C ➔ B)` दिशा रोज्न सकिन्छ। पास गर्दा वा प्रश्न मिलाउँदा स्वतः सोही दिशा अनुसार अर्को टोलीको पालो आउँछ।

3. **स्मार्टबोर्डका लागि सजिलो र स्पष्ट डिजाइन**:
   - बाँकी ५ सेकेन्ड हुँदा टाइमर बक्स रातो भएर घण्टी/वार्निङ संकेत देखा पर्छ।
   - उत्तर बक्समा क्लिक गर्दा मात्र रातो ब्याकग्राउन्डमा उत्तर देखा पर्छ।
